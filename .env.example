# PostgreSQL connection string. URL-encode special characters in the
# password (e.g. @ -> %40).
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

NODE_ENV=development
PORT=4227

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Session lifetime. The access token is what every authenticated request
# carries; when it expires the client is signed out unless it refreshes.
# The refresh token must always outlive the access token. Both accept
# durations like 15m, 12h, 30d.
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="90d"

# Comma-separated list of allowed origins (web admin dev server, Ionic dev
# server, Capacitor native WebView origins).
CORS_ORIGIN="http://localhost:4300,http://localhost:8100,capacitor://localhost,http://localhost"

# Fast2SMS WhatsApp OTP (Phase 3 - mobile OTP). Never commit a real key.
FAST2SMS_API_KEY=
# "Message ID" of the approved otp_verification WhatsApp template (category:
# Authentication), from Fast2SMS's WhatsApp template dashboard - not Meta's
# own template id.
FAST2SMS_WHATSAPP_MESSAGE_ID=
# The WhatsApp Business sender this template sends from, from the same
# dashboard page - not the sender's phone number itself.
FAST2SMS_WHATSAPP_PHONE_NUMBER_ID=
OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_VALIDITY_MINUTES=15


# ---------------------------------------------------------------------------
# Google OAuth 2.0 / YouTube Subscribe verification
# ---------------------------------------------------------------------------
#
# Full walkthrough - console steps, the HTTPS redirect-URI rule, the 7-day
# refresh-token limit while the app is unverified, quota, and a symptom/cause
# table: docs/google-youtube-oauth.md
#
# The authorization-code flow: the backend exchanges a code for real access
# and refresh tokens so it can call the YouTube Data API as the connected
# account. That is why the CLIENT SECRET lives here, on the backend, and
# never in Angular or Ionic.
#
# In the Google Cloud console, create an OAuth client of type
# "Web application", then:
#   1. Enable the "YouTube Data API v3" for the project.
#   2. Add GOOGLE_REDIRECT_URI below to "Authorized redirect URIs" - exactly,
#      character for character, including the scheme and port.
#   3. Add the scope https://www.googleapis.com/auth/youtube.readonly to the
#      consent screen. While the app is in "Testing", only accounts listed as
#      test users can complete the flow.
#
# Leave both blank to run without the feature: the connect endpoints answer
# GOOGLE_OAUTH_NOT_CONFIGURED and every other part of the platform behaves
# exactly as before.
#
# GOOGLE_CLIENT_ID is not a secret (it travels in every consent URL); only
# the secret below is. Users sign in with phone + OTP - there is no Google
# login - so neither value has anything to do with authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ONE redirect URI serves both roles - which account a callback belongs to
# travels in the signed `state`, not in the URI. Must be reachable by the
# browser completing consent, so on a phone this is the LAN address, not
# localhost. Defaults to PUBLIC_WEB_URL + /api/google-oauth/callback.
GOOGLE_REDIRECT_URI=
# Where the browser is sent AFTER the callback has stored the tokens - a
# landing page, never registered with Google. The agent panel returns to its
# own YouTube Account screen; the Ionic app has no URL of its own inside a
# Capacitor WebView, so leaving the user one blank makes the backend render a
# "you can close this window" page instead, which is what it should do.
GOOGLE_AGENT_REDIRECT_URI=
GOOGLE_USER_REDIRECT_URI=
# How long a signed OAuth state stays valid - long enough to read a consent
# screen, short enough that one captured from browser history is useless.
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Ceiling on any single Google/YouTube API call, same reasoning as
# SMS_TIMEOUT_MS - these run inside a request a user is waiting on.
GOOGLE_API_TIMEOUT_MS=10000

# Encrypts the OAuth tokens at rest (AES-256-GCM). Any long random string
# works - it is stretched to a 32-byte key - but it MUST stay stable:
# changing it makes every stored token undecryptable, which surfaces as every
# connected account being asked to reconnect. Falls back to JWT_ACCESS_SECRET
# when blank, so tokens are never stored in plaintext just because this was
# left unset.
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# SMTP (agent registration email verification, password reset). Leave blank
# to run without it - email.service.ts logs the link instead of sending
# (never in production - see env.ts). Never commit real credentials here.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
# true only for port 465 (implicit TLS); 587/25 use STARTTLS instead.
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@Earnivo.app
SMTP_FROM_NAME=Earnivo

# ---------------------------------------------------------------------------
# Runtime tuning (concurrency, timeouts, throughput)
# ---------------------------------------------------------------------------

# Worker processes. Node runs JavaScript on one thread, so a single process
# uses exactly one CPU core however many requests arrive together.
#   0 = one worker per core (use this in production)
#   1 = no clustering (use this with the watch-mode dev server)
# One worker also runs the cron sweeps; the rest only serve requests.
CLUSTER_WORKERS=0

# Set to the number of proxy hops (usually 1) when nginx or a load balancer
# sits in front, so rate limiting sees real client IPs instead of counting
# every request against the proxy. Leave blank when nothing is in front:
# trusting a forwarded header with no proxy lets callers spoof their IP.
TRUST_PROXY=1

# PostgreSQL connection pool. Each in-flight query holds one connection, so
# this is the real ceiling on database concurrency. Keep
# (DB_POOL_MAX x CLUSTER_WORKERS) below the server's max_connections (100 by
# default) - with 4 workers, 20 each already reaches 80.
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
# PostgreSQL-enforced ceiling on any single statement, so one bad query
# cannot hold a pooled connection and starve everything queued behind it.
DB_STATEMENT_TIMEOUT_MS=15000

# HTTP timeouts. Keep-alive must stay above the idle timeout of anything in
# front (a typical load balancer uses 60s) or clients see random 502s, and
# the headers timeout must stay above keep-alive.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
HTTP_REQUEST_TIMEOUT_MS=120000
# Grace period for in-flight requests to finish on shutdown.
SHUTDOWN_TIMEOUT_MS=15000

# Rate limits, counted per IP per window. Everyone behind one office or
# mobile-carrier NAT shares a budget, which is why these are generous. With
# clustering the counters are per worker, so the effective ceiling is
# (limit x CLUSTER_WORKERS).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_REFERRAL_MAX=120

# Largest JSON/form body accepted. Image uploads bypass this entirely.
JSON_BODY_LIMIT=256kb

# bcrypt cost. Each extra round doubles hashing time, and hashing is the
# most expensive thing in the login path. 10 is still far above the point
# where offline cracking is cheap. Existing hashes keep working: the cost is
# stored inside each hash.
BCRYPT_ROUNDS=10

# gzip responses above this many bytes.
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD=1024

# Ceilings on outbound calls, so a hung WhatsApp or SMTP provider cannot hold
# inbound requests open indefinitely.
WHATSAPP_TIMEOUT_MS=10000
SMTP_TIMEOUT_MS=10000

# Request logging. Health checks are never logged.
HTTP_LOG_ENABLED=true
# HTTP_LOG_FORMAT=combined

# Threads for bcrypt and file I/O. Defaults to (2 x CPU cores, min 8, max
# 32) when unset - the Node default of 4 is the bottleneck under concurrent
# logins.
# UV_THREADPOOL_SIZE=16

# --- Push notifications (Firebase Cloud Messaging) --------------------
#
# These are NOT the same thing as angular-ionic/android/app/
# google-services.json. That file only tells the *device* which Firebase
# project to register with and carries no authority to send anything; the
# sender ID / project number inside it (865468396378) is likewise a public
# identifier, not a credential. Only a SERVICE ACCOUNT can call the FCM v1
# send API.
#
# To get these three values:
#   Firebase Console -> Project settings -> Service accounts
#   -> "Generate new private key" -> downloads a JSON file
# Then copy from that JSON: project_id, client_email, private_key.
#
# Leave them blank to run without push. push.service.ts then logs what it
# would have sent and returns successfully, exactly like the OTP and email
# services do without their own credentials - nothing else in the app
# changes or fails.
FIREBASE_PROJECT_ID=earnivo-728f9
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value as a SINGLE line, keeping its literal \n
# sequences and wrapping the whole thing in double quotes - a real multi-
# line PEM cannot survive a .env file. env.ts turns the \n back into real
# newlines before use.
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Ceiling on a single FCM send, same reasoning as SMS_TIMEOUT_MS.
PUSH_TIMEOUT_MS=10000
# FCM v1 takes one device token per request, so a platform-wide campaign
# announcement is one request per device. This caps how many are in flight
# at once.
PUSH_CONCURRENCY=20
